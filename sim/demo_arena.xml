<mujoco model="PRIMUS Franka-Style Arm Arena">
    <option timestep="0.002" gravity="0 0 -9.81"/>
    
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.1 0.2 0.3" rgb2="0.0 0.0 0.0" width="100" height="100"/>
        <material name="table_mat" rgba="0.2 0.2 0.2 1.0" reflectance="0.2" shininess="0.5"/>
        <material name="arm_white" rgba="0.9 0.9 0.9 1.0" reflectance="0.3" shininess="0.8"/>
        <material name="arm_dark" rgba="0.1 0.1 0.1 1.0" reflectance="0.5" shininess="0.8"/>
        <material name="skin_mat" rgba="0.9 0.7 0.5 1.0" reflectance="0.2" shininess="0.3"/>
        <material name="red_mat" rgba="0.9 0.1 0.1 1.0" reflectance="0.3" shininess="0.5"/>
        <material name="blue_mat" rgba="0.1 0.1 0.9 1.0" reflectance="0.3" shininess="0.5"/>
        <material name="green_mat" rgba="0.1 0.9 0.1 1.0" reflectance="0.3" shininess="0.5"/>
        <material name="yellow_mat" rgba="0.9 0.9 0.1 1.0" reflectance="0.3" shininess="0.5"/>
        <material name="target_mat" rgba="0.9 0.9 0.9 0.5" reflectance="0.1" shininess="0.1"/>
    </asset>

    <worldbody>
        <camera name="presentation_cam" pos="1.0 -1.0 1.5" xyaxes="1 1 0 -0.5 0.5 1.5" fovy="50"/>
        <light directional="true" diffuse="0.8 0.8 0.8" pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="3 3 0.1" rgba="0.1 0.1 0.1 1"/>

        <!-- THE TABLE -->
        <body name="lab_table" pos="0 0.4 0">
            <!-- Table Top -->
            <geom name="table_top" type="box" size="0.8 0.8 0.05" pos="0 0 0.75" material="table_mat"/>
            <!-- Table Legs -->
            <geom name="leg1" type="cylinder" size="0.04 0.375" pos="-0.7 -0.7 0.375" material="table_mat"/>
            <geom name="leg2" type="cylinder" size="0.04 0.375" pos="0.7 -0.7 0.375" material="table_mat"/>
            <geom name="leg3" type="cylinder" size="0.04 0.375" pos="-0.7 0.7 0.375" material="table_mat"/>
            <geom name="leg4" type="cylinder" size="0.04 0.375" pos="0.7 0.7 0.375" material="table_mat"/>

            <!-- ROBOT BASE (WELDED TO TABLE) -->
            <body name="arm_base" pos="0 -0.3 0.8">
                <geom name="base_mount" type="cylinder" size="0.08 0.05" material="arm_dark"/>

                <!-- LINK 1: UPPER ARM (Franka Style) -->
                <body name="upper_arm" pos="0 0 0.05">
                    <joint name="j1" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="2"/>
                    <geom name="link1" type="capsule" size="0.04 0.2" pos="0 0 0.2" material="arm_white"/>

                    <!-- LINK 2: FOREARM -->
                    <body name="forearm" pos="0 0 0.4">
                        <joint name="j2" type="hinge" axis="0 1 0" range="-1.5 0.5" damping="2"/>
                        <geom name="link2" type="capsule" size="0.035 0.18" pos="0 0 0.18" material="arm_white"/>

                        <!-- LINK 3: HUMAN HAND (No Gripper) -->
                        <body name="hand" pos="0 0 0.36">
                            <joint name="j3" type="hinge" axis="0 1 0" range="-1.5 1.5" damping="1"/>
                            <!-- Palm -->
                            <geom name="palm" type="box" size="0.04 0.05 0.06" pos="0 0 0.06" material="skin_mat"/>
                            <!-- Fingers -->
                            <geom name="finger1" type="capsule" size="0.015 0.04" pos="0.03 0 0.12" quat="1 0 0 1" material="skin_mat"/>
                            <geom name="finger2" type="capsule" size="0.015 0.04" pos="-0.03 0 0.12" quat="1 0 0 1" material="skin_mat"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        <!-- TASK OBJECTS ON TABLE (z=0.83 is table surface) -->
        <body name="red_block" pos="-0.3 0.4 0.83">
            <geom name="red_geom" type="box" size="0.04 0.04 0.04" material="red_mat"/>
        </body>
        <geom name="target_north" type="box" size="0.06 0.06 0.01" pos="0.3 0.4 0.78" material="target_mat"/>

        <body name="blue_cup" pos="-0.3 0.8 0.83">
            <geom name="blue_geom" type="cylinder" size="0.04 0.06" material="blue_mat"/>
        </body>
        <geom name="target_south" type="box" size="0.06 0.06 0.01" pos="0.3 0.8 0.78" material="target_mat"/>

        <body name="green_ball" pos="0.0 0.6 0.83">
            <geom name="green_geom" type="sphere" size="0.04" material="green_mat"/>
        </body>
        <geom name="target_east" type="box" size="0.06 0.06 0.01" pos="0.4 0.6 0.78" material="target_mat"/>

        <body name="yellow_block" pos="-0.4 0.6 0.83">
            <geom name="yellow_geom" type="box" size="0.04 0.04 0.04" material="yellow_mat"/>
        </body>
    </worldbody>
</mujoco>
