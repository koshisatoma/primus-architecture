<mujoco model="PRIMUS Demo Scene">
    <option timestep="0.002" gravity="0 0 -9.81"/>
    
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="100" height="100"/>
        <material name="table_mat" rgba="0.5 0.4 0.3 1.0" reflectance="0.2"/>
        <material name="red_mat" rgba="0.9 0.1 0.1 1.0" reflectance="0.3"/>
        <material name="blue_mat" rgba="0.1 0.1 0.9 1.0" reflectance="0.3"/>
        <material name="target_mat" rgba="0.1 0.8 0.1 0.5" reflectance="0.1"/>
        <material name="arm_mat" rgba="0.8 0.8 0.8 1.0" reflectance="0.4"/>
    </asset>

    <worldbody>
        <light directional="true" diffuse="0.8 0.8 0.8" pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="5 5 0.1" rgba="0.2 0.2 0.2 1"/>

        <!-- G1 Robot (Positioned BEHIND the table so it doesn't get stuck) -->
        <body name="g1_base" pos="0 -0.8 0">
            <geom name="base_visual" type="cylinder" size="0.2 0.1" pos="0 0 0.1" material="arm_mat"/>
            <!-- We only expose the right arm for the demo to keep it stable -->
            <body name="right_shoulder" pos="0 -0.15 0.5">
                <joint name="j1" type="hinge" axis="0 1 0" range="-1.5 1.5" damping="1"/>
                <geom name="link1" type="capsule" size="0.04 0.15" pos="0 0 0.15" material="arm_mat"/>
                
                <body name="right_elbow" pos="0 0 0.3">
                    <joint name="j2" type="hinge" axis="0 1 0" range="-1.5 0.5" damping="1"/>
                    <geom name="link2" type="capsule" size="0.03 0.12" pos="0 0 0.12" material="arm_mat"/>
                    
                    <body name="right_wrist" pos="0 0 0.24">
                        <joint name="j3" type="hinge" axis="0 1 0" range="-1.5 1.5" damping="1"/>
                        <geom name="gripper" type="box" size="0.04 0.04 0.04" pos="0 0 0.04" material="arm_mat"/>
                    </body>
                </body>
            </body>
        </body>

        <!-- Table (In front of the robot) -->
        <body name="table" pos="0 0.2 0">
            <geom name="table_top" type="box" size="0.6 0.4 0.05" pos="0 0 0.75" material="table_mat"/>
            <geom name="leg1" type="cylinder" size="0.04 0.75" pos="-0.5 -0.3 0.375" material="table_mat"/>
            <geom name="leg2" type="cylinder" size="0.04 0.75" pos="0.5 -0.3 0.375" material="table_mat"/>
            <geom name="leg3" type="cylinder" size="0.04 0.75" pos="-0.5 0.3 0.375" material="table_mat"/>
            <geom name="leg4" type="cylinder" size="0.04 0.75" pos="0.5 0.3 0.375" material="table_mat"/>
        </body>

        <!-- The Object to Move (Red Cube on the left) -->
        <body name="red_block" pos="-0.2 0.2 0.85">
            <geom name="red_geom" type="box" size="0.04 0.04 0.04" material="red_mat"/>
        </body>

        <!-- The Target (Green Mat on the right - clear visual target for the panel) -->
        <body name="target_zone" pos="0.2 0.2 0.78">
            <geom name="target_geom" type="box" size="0.06 0.06 0.01" material="target_mat"/>
        </body>
    </worldbody>
</mujoco>
