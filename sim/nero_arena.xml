<mujoco model="Nero 7-DoF Arena">
    <compiler angle="radian"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
        <global azimuth="120" elevation="-20" offwidth="800" offheight="600"/>
    </visual>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.1 0.2 0.3" rgb2="0.0 0.0 0.0" width="100" height="100"/>
        <material name="table_mat" rgba="0.15 0.15 0.15 1.0" reflectance="0.2"/>
        <material name="nero_base" rgba="0.1 0.1 0.1 1.0" reflectance="0.5" shininess="0.8"/>
        <material name="nero_arm" rgba="0.8 0.8 0.85 1.0" reflectance="0.4" shininess="0.6"/>
        <material name="nero_joint" rgba="0.2 0.2 0.2 1.0" reflectance="0.5"/>
        <material name="red_mat" rgba="0.9 0.1 0.1 1.0"/>
        <material name="blue_mat" rgba="0.1 0.35 0.95 1.0"/>
        <material name="cup_mat" rgba="0.95 0.55 0.08 1.0"/>
        <material name="glass_mat" rgba="0.65 0.9 1.0 0.45"/>
        <material name="plate_mat" rgba="0.9 0.9 0.95 1.0"/>
        <material name="box_mat" rgba="0.45 0.3 0.16 1.0"/>
        <material name="target_mat" rgba="0.1 0.9 0.1 0.4"/>
    </asset>
    <worldbody>
        <camera name="top_cam" pos="0 -6 5" xyaxes="1 0 0 0 0.536 0.844" fovy="45"/>
        <light directional="true" diffuse="0.8 0.8 0.8" pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="3 3 0.1" rgba="0.05 0.05 0.05 1"/>

        <!-- Table -->
        <body name="table" pos="0 0.4 0">
            <geom name="table_top" type="box" size="0.8 0.8 0.05" pos="0 0 0.75" material="table_mat"/>
            <geom name="leg1" type="cylinder" size="0.04 0.375" pos="-0.7 -0.7 0.375" material="table_mat"/>
            <geom name="leg2" type="cylinder" size="0.04 0.375" pos="0.7 -0.7 0.375" material="table_mat"/>
            <geom name="leg3" type="cylinder" size="0.04 0.375" pos="-0.7 0.7 0.375" material="table_mat"/>
            <geom name="leg4" type="cylinder" size="0.04 0.375" pos="0.7 0.7 0.375" material="table_mat"/>
        </body>

        <!-- NERO 7-DoF Robotic Arm (Welded to Table) -->
        <body name="nero_base" pos="0 -0.2 0.8">
            <geom name="base_mount" type="cylinder" size="0.08 0.05" material="nero_base"/>

            <!-- Joint 1: Base Rotation -->
            <body name="link1" pos="0 0 0.05">
                <joint name="j1" type="hinge" axis="0 0 1" range="-2.96 2.96" damping="1"/>
                <geom name="geom1" type="capsule" size="0.06 0.05" pos="0 0 0.05" material="nero_arm"/>

                <!-- Joint 2: Shoulder Pitch -->
                <body name="link2" pos="0 0 0.1">
                    <joint name="j2" type="hinge" axis="0 1 0" range="-2.09 2.09" damping="1"/>
                    <geom name="geom2" type="capsule" size="0.05 0.15" pos="0 0 0.15" material="nero_arm"/>

                    <!-- Joint 3: Shoulder Yaw -->
                    <body name="link3" pos="0 0 0.3">
                        <joint name="j3" type="hinge" axis="0 0 1" range="-2.96 2.96" damping="1"/>
                        <geom name="geom3" type="capsule" size="0.045 0.12" pos="0 0 0.12" material="nero_joint"/>

                        <!-- Joint 4: Elbow Pitch -->
                        <body name="link4" pos="0 0 0.24">
                            <joint name="j4" type="hinge" axis="0 1 0" range="-3.0 0.0" damping="1"/>
                            <geom name="geom4" type="capsule" size="0.04 0.15" pos="0 0 0.15" material="nero_arm"/>

                            <!-- Joint 5: Wrist Yaw -->
                            <body name="link5" pos="0 0 0.3">
                                <joint name="j5" type="hinge" axis="0 0 1" range="-2.96 2.96" damping="1"/>
                                <geom name="geom5" type="capsule" size="0.035 0.08" pos="0 0 0.08" material="nero_joint"/>

                                <!-- Joint 6: Wrist Pitch -->
                                <body name="link6" pos="0 0 0.16">
                                    <joint name="j6" type="hinge" axis="0 1 0" range="-2.09 2.09" damping="1"/>
                                    <geom name="geom6" type="capsule" size="0.03 0.06" pos="0 0 0.06" material="nero_arm"/>

                                    <!-- Joint 7: Wrist Roll -->
                                    <body name="link7" pos="0 0 0.12">
                                        <joint name="j7" type="hinge" axis="0 0 1" range="-2.96 2.96" damping="1"/>
                                        <geom name="geom7" type="capsule" size="0.025 0.05" pos="0 0 0.05" material="nero_joint"/>

                                        <!-- End Effector / Gripper -->
                                        <body name="nero_ee" pos="0 0 0.1">
                                            <geom name="ee_base" type="box" size="0.04 0.04 0.04" material="nero_base"/>
                                            <body name="finger_left" pos="0.03 0 0.04">
                                                <joint name="gripper_j1" type="slide" axis="1 0 0" range="0 0.04" damping="0.1"/>
                                                <geom name="finger_left_geom" type="box" size="0.01 0.02 0.04" material="nero_base"/>
                                            </body>
                                            <body name="finger_right" pos="-0.03 0 0.04">
                                                <joint name="gripper_j2" type="slide" axis="-1 0 0" range="0 0.04" damping="0.1"/>
                                                <geom name="finger_right_geom" type="box" size="0.01 0.02 0.04" material="nero_base"/>
                                            </body>
                                        </body>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        <!-- Open box and destinations -->
        <body name="stacking_box" pos="-0.48 0.76 0.8">
            <geom name="box_floor" type="box" size="0.18 0.16 0.015" pos="0 0 0.015" material="box_mat"/>
            <geom name="box_wall_left" type="box" size="0.015 0.16 0.075" pos="-0.165 0 0.09" material="box_mat"/>
            <geom name="box_wall_right" type="box" size="0.015 0.16 0.075" pos="0.165 0 0.09" material="box_mat"/>
            <geom name="box_wall_front" type="box" size="0.18 0.015 0.075" pos="0 -0.145 0.09" material="box_mat"/>
            <geom name="box_wall_back" type="box" size="0.18 0.015 0.075" pos="0 0.145 0.09" material="box_mat"/>
        </body>
        <geom name="cup_target" type="cylinder" size="0.11 0.004" pos="0.12 0.2 0.804" material="target_mat"/>

        <!-- Every movable ingredient starts on the tabletop within arm reach. -->
        <body name="cube_red" pos="-0.08 0.53 0.84">
            <freejoint name="cube_red_free"/>
            <geom name="cube_red_geom" type="box" size="0.04 0.04 0.04" material="red_mat"/>
        </body>
        <body name="cube_blue" pos="0.12 0.53 0.84">
            <freejoint name="cube_blue_free"/>
            <geom name="cube_blue_geom" type="box" size="0.04 0.04 0.04" material="blue_mat"/>
        </body>
        <body name="cup" pos="0.52 0.12 0.87">
            <freejoint name="cup_free"/>
            <geom name="cup_body" type="cylinder" size="0.055 0.07" material="cup_mat"/>
            <geom name="cup_handle_top" type="capsule" size="0.009" fromto="0.048 0 0.05 0.07 0 0.05" material="cup_mat"/>
            <geom name="cup_handle_side" type="capsule" size="0.009" fromto="0.07 0 0.05 0.07 0 -0.05" material="cup_mat"/>
            <geom name="cup_handle_bottom" type="capsule" size="0.009" fromto="0.07 0 -0.05 0.048 0 -0.05" material="cup_mat"/>
        </body>
        <body name="glass" pos="0.35 0.74 0.88">
            <freejoint name="glass_free"/>
            <geom name="glass_body" type="cylinder" size="0.045 0.08" material="glass_mat"/>
            <geom name="glass_rim" type="cylinder" size="0.05 0.006" pos="0 0 0.078" material="glass_mat"/>
        </body>
        <body name="plate" pos="-0.43 0.12 0.82">
            <freejoint name="plate_free"/>
            <geom name="plate_base" type="cylinder" size="0.14 0.015" material="plate_mat"/>
            <geom name="plate_inner" type="cylinder" size="0.105 0.006" pos="0 0 0.016" rgba="0.75 0.8 0.9 1"/>
        </body>
    </worldbody>
</mujoco>
