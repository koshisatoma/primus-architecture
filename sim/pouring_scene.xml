  <actuator>
    <position name="a1" joint="j1" kp="100" ctrlrange="-3.14 3.14" />
    <position name="a2" joint="j2" kp="100" ctrlrange="-2.5 2.5" />
    <position name="a3" joint="j3" kp="80" ctrlrange="-2.5 2.5" />
    <position name="a4" joint="j4" kp="50" ctrlrange="-2.5 2.5" />
  </actuator>
