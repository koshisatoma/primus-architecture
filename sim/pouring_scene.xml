    <body name="glass" pos="0.34 0.58 0.81">
      <geom name="glass_wall" type="cylinder" size="0.065 0.11"
            material="glass_material" contype="0" conaffinity="0" />
      <geom name="glass_water" type="cylinder" pos="0 0 -0.025" size="0.05 0.055"
            material="water_material" contype="0" conaffinity="0" />
      <geom name="glass_base" type="cylinder" pos="0 0 -0.105" size="0.06 0.008"
            material="glass_material" contype="0" conaffinity="0" />
