<mujoco model="PRIMUS pouring demo">
  <compiler angle="radian" />
  <option timestep="0.002" gravity="0 0 -9.81" />

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.25 0.25 0.25" />
    <map znear="0.02" />
  </visual>

  <asset>
    <texture name="floor_texture" type="2d" builtin="checker" rgb1="0.18 0.2 0.23"
             rgb2="0.28 0.3 0.33" width="512" height="512" />
    <material name="floor_material" texture="floor_texture" texrepeat="5 5" />
    <material name="table_material" rgba="0.35 0.23 0.14 1" />
    <material name="arm_material" rgba="0.78 0.8 0.84 1" />
    <material name="jar_material" rgba="0.12 0.32 0.78 1" />
    <material name="water_material" rgba="0.12 0.55 0.95 0.85" />
    <material name="glass_material" rgba="0.78 0.9 1 0.35" />
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -2 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" />
    <geom name="floor" type="plane" size="4 4 0.1" material="floor_material" />

    <body name="table" pos="0 0.45 0">
      <geom name="table_top" type="box" pos="0 0 0.7" size="0.85 0.55 0.05"
            material="table_material" />
      <geom name="table_leg_1" type="cylinder" pos="-0.72 -0.42 0.34" size="0.04 0.34"
            material="table_material" />
      <geom name="table_leg_2" type="cylinder" pos="0.72 -0.42 0.34" size="0.04 0.34"
            material="table_material" />
      <geom name="table_leg_3" type="cylinder" pos="-0.72 0.42 0.34" size="0.04 0.34"
