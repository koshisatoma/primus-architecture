          <geom name="link_2" type="capsule" pos="0 0 0.15" size="0.035 0.15"
                material="arm_material" contype="0" conaffinity="0" />
          <body name="wrist" pos="0 0 0.3">
            <joint name="j3" type="hinge" axis="0 1 0" range="-2.5 2.5"
