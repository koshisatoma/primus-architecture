            contype="0" conaffinity="0" />
    </body>

    <body name="arm_base" pos="0 0 0.76">
      <geom name="arm_base_geom" type="cylinder" size="0.1 0.06"
            material="arm_material" contype="0" conaffinity="0" />
      <body name="shoulder" pos="0 0 0.1">
        <joint name="j1" type="hinge" axis="0 0 1" range="-3.14 3.14"
